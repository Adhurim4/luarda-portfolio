# LinkedIn profile (optional)
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form — Web3Forms (recommended for production)
# 1. https://web3forms.com → set recipient to gjataluarda@gmail.com
# 2. Copy Access Key → add in Vercel Environment Variables:
#    NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_key_here
#    (Must use NEXT_PUBLIC_ — form submits from the browser, not the server.)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: Resend via /api/contact (server-side, needs RESEND_API_KEY on Vercel)
RESEND_API_KEY=
CONTACT_TO_EMAIL=gjataluarda@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
